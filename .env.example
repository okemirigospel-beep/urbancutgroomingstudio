# Safe defaults: no domain selected; no indexing. Rebuild after changing either value.
# After the dashboard confirms the stable address, set SITE_URL to that HTTPS origin.
# For Vercel testing, keep indexing false. Never use a deployment-hash URL.
# Leave blank/omit before the stable address is confirmed; rebuild after setting it.
SITE_URL=
# Set true only for an explicitly authorised launch. A domain alone is insufficient.
SITE_INDEXING_ENABLED=false

# Reserved for a separately authorised Supabase integration; unused for now.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Never place service-role credentials in NEXT_PUBLIC variables.
